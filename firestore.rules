rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && (
        request.auth.token.email == 'vule160404@gmail.com' ||
        request.auth.token.email == 'cycloneielts@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile & Administration
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      // User Playlists subcollection
      match /playlists/{playlistId} {
        allow read, write: if (isOwner(userId) || isAdmin()) && isValidId(playlistId);
      }

      // User Liked Tracks subcollection
      match /liked/{trackId} {
        allow read, write: if (isOwner(userId) || isAdmin()) && isValidId(trackId);
      }
    }
  }
}
