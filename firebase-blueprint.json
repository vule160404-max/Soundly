{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile information",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "UserPlaylist": {
      "title": "UserPlaylist",
      "description": "A playlist created by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "coverUrl": { "type": "string" },
        "trackIds": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "UserLikedTrack": {
      "title": "UserLikedTrack",
      "description": "A track liked by a user",
      "type": "object",
      "properties": {
        "trackId": { "type": "string" },
        "userId": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["trackId", "userId"]
    },
    "SoundlyTrack": {
      "title": "SoundlyTrack",
      "description": "A music track uploaded to Cloudflare R2 and published in the Soundly catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "artist": { "type": "string", "maxLength": 300 },
        "album": { "type": "string", "maxLength": 300 },
        "coverUrl": { "type": "string", "maxLength": 2000 },
        "audioUrl": { "type": "string", "maxLength": 2000 },
        "duration": { "type": "number" },
        "genre": { "type": "string", "maxLength": 100 },
        "releaseYear": { "type": "number" },
        "lyrics": { "type": "array" },
        "bpm": { "type": "number" },
        "mood": { "type": "string", "maxLength": 150 },
        "plays": { "type": "number" },
        "aiClassified": { "type": "boolean" },
        "aiReason": { "type": "string", "maxLength": 500 },
        "spotifyTrackId": { "type": "string", "maxLength": 128 },
        "spotifyUrl": { "type": "string", "maxLength": 500 },
        "r2AudioKey": { "type": "string", "maxLength": 500 },
        "r2CoverKey": { "type": "string", "maxLength": 500 },
        "syncedLyrics": { "type": "string", "maxLength": 50000 },
        "plainLyrics": { "type": "string", "maxLength": 50000 },
        "lyricsMode": { "type": "string", "maxLength": 20, "enum": ["synced", "plain", "none"] }
      },
      "required": ["id", "title", "artist", "audioUrl", "genre"]
    },
    "SoundlyAlbum": {
      "title": "SoundlyAlbum",
      "description": "An admin-curated public app album discoverable via search across all Soundly users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 500 },
        "coverUrl": { "type": "string", "maxLength": 2000 },
        "trackIds": { "type": "array" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "spotifyUrl": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "title", "trackIds"]
    },
    "SoundlyChart": {
      "title": "SoundlyChart",
      "description": "Spotify Trending Chart snapshot matched against Soundly playable tracks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "region": { "type": "string", "enum": ["vn", "global"] },
        "title": { "type": "string", "maxLength": 200 },
        "sourceLabel": { "type": "string", "maxLength": 200 },
        "sourceUrl": { "type": "string", "maxLength": 500 },
        "customSpotifyUrl": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "nextAutoSyncAt": { "type": "string", "maxLength": 64 },
        "totalSpotifyEntries": { "type": "number" },
        "matchedCount": { "type": "number" },
        "entries": { "type": "array" },
        "missingEntries": { "type": "array" }
      },
      "required": ["id", "region", "title", "updatedAt", "entries"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Profile of authenticated user with admin access for vule160404@gmail.com"
    },
    "/users/{userId}/playlists/{playlistId}": {
      "schema": "UserPlaylist",
      "description": "User custom playlists"
    },
    "/users/{userId}/liked/{trackId}": {
      "schema": "UserLikedTrack",
      "description": "Tracks liked by the user"
    },
    "/soundly_tracks/{trackId}": {
      "schema": "SoundlyTrack",
      "description": "Shared music catalog stored in Firestore"
    },
    "/soundly_albums/{albumId}": {
      "schema": "SoundlyAlbum",
      "description": "Admin-managed public app albums discoverable via search"
    },
    "/soundly_charts/{chartId}": {
      "schema": "SoundlyChart",
      "description": "Cached Spotify Top 50 Vietnam & Global trending charts matched to Soundly catalog"
    }
  }
}
